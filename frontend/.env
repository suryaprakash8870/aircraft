# =============================================================================
# Frontend environment (Vite) — copy this file to `.env` and edit as needed.
#
# All values exposed to the browser MUST be prefixed with VITE_.
# See: https://vitejs.dev/guide/env-and-mode.html
#
# Changes to this file require a Vite dev-server restart (Ctrl+C then `npm run dev`).
# =============================================================================

# --- API connection ----------------------------------------------------------
# Backend API URL the React app calls directly.
#
# Leave EMPTY only for production Docker builds where nginx serves the
# bundle and proxies same-origin /api to the backend container.  For all
# other cases, set this to the full backend URL.
VITE_API_BASE_URL=http://localhost:8000/api

# --- Branding ----------------------------------------------------------------
VITE_APP_NAME=AeroFuel
VITE_APP_TAGLINE=Aviation Fuel Management System

# --- Feature flags -----------------------------------------------------------
# Enable verbose console logging for API requests (true | false)
VITE_DEBUG_API=false
