# =============================================================================
# Frontend env — DEVELOPMENT mode (loaded automatically by `npm run dev`)
#
# Vite loads files in this order, later ones overriding earlier ones:
#   .env                  (universal defaults)
#   .env.development      (this file — dev only)
#   .env.development.local (gitignored personal overrides)
#
# Edit this file then restart `npm run dev` for changes to take effect.
# =============================================================================

# Backend API URL — axios calls this directly (no dev-server proxy).
# The backend's CORS middleware (allow_origins=["*"]) permits this.
VITE_API_BASE_URL=http://localhost:8000/api

# Show resolved API base URL in the browser console (handy in dev)
VITE_DEBUG_API=true
