# =============================================================================
# Frontend environment (Vite) — copy this file to `.env` and edit as needed.
#
# All values exposed to the browser MUST be prefixed with VITE_.
# See: https://vitejs.dev/guide/env-and-mode.html
#
# Changes to this file require a Vite dev-server restart (Ctrl+C then `npm run dev`).
# =============================================================================

# --- API connection ----------------------------------------------------------
# Where the React app sends API calls.
#
# Leave EMPTY (default) to use a same-origin relative path. Requests go to
# `/api/*` and are forwarded by Vite's dev proxy (vite.config.js) or by
# nginx (production Docker build) to the backend.  Recommended for most setups.
#
# Set a full URL (e.g. `http://10.0.0.5:8000/api`) to bypass the proxy and
# call the backend directly — useful when serving the built bundle from a
# different host than the API.
VITE_API_BASE_URL=

# Backend host & port used by Vite's dev-server proxy ONLY (not shipped to
# the browser). Adjust if your local backend runs on a non-default port.
VITE_BACKEND_PROXY_TARGET=http://localhost:8002

# --- Branding ----------------------------------------------------------------
VITE_APP_NAME=AeroFuel
VITE_APP_TAGLINE=Aviation Fuel Management System

# --- Feature flags -----------------------------------------------------------
# Enable verbose console logging for API requests (true | false)
VITE_DEBUG_API=false
