# =============================================================================
# Frontend env — PRODUCTION mode (loaded automatically by `npm run build`)
#
# These values are baked into the static JS bundle at build time.
# Anything sensitive must NOT go here (it ends up in the public bundle).
# =============================================================================

# Leave empty so the built app uses same-origin `/api` calls — nginx in the
# production Docker image proxies them to the backend container.  If you
# host the frontend on a different origin than the backend, set this to the
# absolute backend URL (e.g. https://api.aerofuel.example.com/api).
VITE_API_BASE_URL=

VITE_DEBUG_API=false
