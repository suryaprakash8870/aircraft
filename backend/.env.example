# --- Database -----------------------------------------------------------------
# When running backend in Docker Compose, host should be `db` (service name)
# When running backend locally with Dockerized Postgres, host should be `localhost`
DATABASE_URL=postgresql+asyncpg://fuel_user:fuel_pass@db:5432/fuel_management

# --- Security -----------------------------------------------------------------
# IMPORTANT: change this in production to a long random string (min 32 chars)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App config ---------------------------------------------------------------
COMPANY_NAME=AeroFuel Management
COMPANY_LOGO=
UPLOAD_DIR=uploads
